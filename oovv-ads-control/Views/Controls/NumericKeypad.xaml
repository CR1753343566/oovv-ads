<UserControl x:Class="oovv_ads_control.Views.Controls.NumericKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        触摸屏虚拟数字键盘，4 列 5 行：
        第 4 列放 保存/取消，各占两行；+/- 在 0 左边，小数点在 0 右边；
        最后一行 清空/回退 各占两列。
        依赖宿主的 DataContext 暴露 AppendDigitCommand/ToggleSignCommand/BackspaceCommand/ClearCommand/
        SaveCommand/CancelCommand 这几个命名（目前只有 NumericInputDialogViewModel 这一个实现），
        复用到别处时照这个命名约定实现就行。
    -->
    <UserControl.Resources>
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 第 1 行：7 8 9 + 保存（占第1-2行） -->
        <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="7" />
        <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="8" />
        <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="9" />
        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                Style="{StaticResource KeypadButtonStyle}"
                ContentTemplate="{StaticResource IconContentTemplate}"
                Content="{Binding IsValid, Converter={StaticResource BoolToStringConverter}, ConverterParameter='/Assets/Icons/submit.png|/Assets/Icons/submit_reject.png'}"
                Command="{Binding SaveCommand}" />

        <!-- 第 2 行：4 5 6 -->
        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="4" />
        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="5" />
        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="6" />

        <!-- 第 3 行：1 2 3 + 取消（占第3-4行） -->
        <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="1" />
        <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="2" />
        <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="3" />
        <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2"
                Style="{StaticResource KeypadButtonStyle}"
                ContentTemplate="{StaticResource IconContentTemplate}"
                Content="/Assets/Icons/exit_warning.png"
                Command="{Binding CancelCommand}" />

        <!-- 第 4 行：+/- 0 . -->
        <Button Grid.Row="3" Grid.Column="0" Content="+/-" Style="{StaticResource KeypadButtonStyle}" Command="{Binding ToggleSignCommand}" />
        <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="0" />
        <Button Grid.Row="3" Grid.Column="2" Content="." Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="." />

        <!-- 第 5 行：清空 占两列，回退 占两列 -->
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource KeypadButtonStyle}"
                ContentTemplate="{StaticResource IconContentTemplate}"
                Content="/Assets/Icons/clear.png"
                Command="{Binding ClearCommand}" />
        <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                Style="{StaticResource KeypadButtonStyle}"
                ContentTemplate="{StaticResource IconContentTemplate}"
                Content="/Assets/Icons/del.png"
                Command="{Binding BackspaceCommand}" />
    </Grid>
</UserControl>
