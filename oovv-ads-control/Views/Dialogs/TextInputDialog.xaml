<Window x:Class="oovv_ads_control.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:oovv_ads_control.Views.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：ESC + 输入框（带光标，IsReadOnly 防止触发系统触屏软键盘）+ 取消/确认图标 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="ESC" Command="{Binding CancelCommand}" Width="60" Height="40" Margin="0,0,8,0" />

            <!-- CaretIndex 不是依赖属性，不能用 Binding——光标位置在 code-behind 里手动同步 -->
            <TextBox x:Name="InputTextBox" Grid.Column="1"
                     Text="{Binding Text, Mode=OneWay}"
                     IsReadOnly="True"
                     FontSize="20" Padding="8" VerticalContentAlignment="Center" />

            <Button Grid.Column="2" Margin="8,0,0,0" Width="44" Height="40"
                    ContentTemplate="{StaticResource IconContentTemplate}"
                    Content="/Assets/Icons/exit.png"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Width="44" Height="40"
                    ContentTemplate="{StaticResource IconContentTemplate}"
                    Content="/Assets/Icons/submit.png"
                    Command="{Binding SaveCommand}" />
        </Grid>

        <!-- 虚拟字母数字键盘 -->
        <controls:AlphanumericKeypad Grid.Row="1" Height="360" />
    </Grid>
</Window>
