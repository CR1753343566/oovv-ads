<Window x:Class="oovv_ads_control.Views.Dialogs.NumericInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:oovv_ads_control.Views.Controls"
        mc:Ignorable="d"
        Title="{Binding ParameterName}"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 参数名 -->
        <TextBlock Grid.Row="0" Text="{Binding ParameterName}" FontSize="18" FontWeight="Bold" />

        <!-- 实际值：打开弹窗那一刻的快照，不会跟着 PLC 实时刷新 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="实际值：" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActualValueText}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,4,0" />
            <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <!-- 设定值：IsReadOnly 防止点击时弹出系统自带的触屏软键盘和这里的虚拟键盘打架 -->
        <TextBox Grid.Row="2" Margin="0,12,0,0"
                 Text="{Binding InputText, Mode=OneWay}"
                 IsReadOnly="True"
                 FontSize="28" HorizontalContentAlignment="Right"
                 Padding="8">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Foreground" Value="#DC2626" />
                            <Setter Property="BorderBrush" Value="#DC2626" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!-- 范围提示 / 超限警告 -->
        <StackPanel Grid.Row="3" Margin="0,4,0,0">
            <TextBlock Text="{Binding RangeText}" Foreground="Gray" FontSize="12" />
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626" FontSize="12" FontWeight="Bold" />
        </StackPanel>

        <!-- 虚拟数字键盘：保存/取消已经并到键盘的第 4 列里，这里不再单独放按钮 -->
        <controls:NumericKeypad Grid.Row="4" Margin="0,12,0,0" Loaded="NumericKeypad_Loaded" />
    </Grid>
</Window>
