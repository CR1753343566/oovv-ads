<Application x:Class="oovv_ads_control.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:oovv_ads_control"
             xmlns:converters="clr-namespace:oovv_ads_control.Converters"
             xmlns:pageVm="clr-namespace:oovv_ads_control.ViewModels.Pages"
             xmlns:pageViews="clr-namespace:oovv_ads_control.Views.Pages"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BoolToStringConverter x:Key="BoolToStringConverter" />

        <!--
            全局图标资源方案：Button.Content 直接写图标的 pack URI 字符串（比如 "/Assets/Icons/clear.png"），
            套上这个 ContentTemplate 就会被渲染成图标，而不是显示文字。跟 Button 具体用哪个 Style（大小/间距）无关，
            两者独立叠加：Style="{StaticResource XxxButtonStyle}" ContentTemplate="{StaticResource IconContentTemplate}"。
            新图标只要按 Assets/Icons/xxx.png 这个约定放进去，.csproj 里是通配符引用，不用改工程文件。
        -->
        <DataTemplate x:Key="IconContentTemplate">
            <Image Source="{Binding}" Width="28" Height="28" Stretch="Uniform" />
        </DataTemplate>

        <!-- 页面 ViewModel -> View 的映射：新增页面时在这里加一条 DataTemplate -->
        <DataTemplate DataType="{x:Type pageVm:DashboardViewModel}">
            <pageViews:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pageVm:ConnectingViewModel}">
            <pageViews:ConnectingView />
        </DataTemplate>

        <!--
            全局默认控件尺寸：目标硬件是 15 寸 4:3 触摸屏（1024x768，外接倍福 Win10 工控机），
            WPF 默认控件尺寸（Button/TextBox 大约 21px 高）远够不到触摸屏可靠点击的下限。
            这里用不带 x:Key 的隐式 Style（TargetType 直接命中所有该类型控件），全项目自动生效；
            已经显式指定了自己 Style 的控件（比如 NumericKeypad/AlphanumericKeypad 里的按键）不受影响，
            因为显式 Style 的优先级高于这种隐式的全局默认值。以后新页面不用每个控件都手动加尺寸，
            不满足触摸场景才需要单独覆盖。
        -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Application.Resources>
</Application>
