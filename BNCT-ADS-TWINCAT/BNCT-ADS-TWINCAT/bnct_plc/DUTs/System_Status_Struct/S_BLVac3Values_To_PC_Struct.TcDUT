	PARAM012:BOOL ; // 束流线放气阀3开启操作错误 
	PARAM013:BOOL ; // 束流线放气阀2关闭操作错误 
	PARAM014:BOOL ; // 束流线3机械泵开到位 
	PARAM015:BOOL ; // 束流线3机械泵关到位 
	PARAM016:BOOL ; // 束流线3机械泵正在开 
	PARAM017:BOOL ; // 束流线3机械泵正在关 
