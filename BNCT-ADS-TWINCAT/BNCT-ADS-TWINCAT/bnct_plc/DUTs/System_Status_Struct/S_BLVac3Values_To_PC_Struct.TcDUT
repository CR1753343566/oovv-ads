	PARAM007:BOOL ; // 束流线角阀3关闭操作错误 
	PARAM008:BOOL ; // 束流线放气阀3开到位 
	PARAM009:BOOL ; // 束流线放气阀3关到位 
	PARAM010:BOOL ; // 束流线放气阀3正在开 
