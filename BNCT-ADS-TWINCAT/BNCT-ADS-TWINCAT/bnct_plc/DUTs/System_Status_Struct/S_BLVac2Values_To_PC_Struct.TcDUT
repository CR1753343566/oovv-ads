  <DUT Name="S_BLVac2Values_To_PC_Struct" Id="{1dbd7bcc-08ff-4297-8ffc-4c9b2a10c771}">
    <Declaration><![CDATA[TYPE S_BLVac2Values_To_PC_Struct :
STRUCT
	PARAM000:BOOL ; // 束流线2低真空自动运行，True代表开 
	PARAM001:BOOL ; // 束流线2高真空自动运行，True代表开 
	PARAM002:BOOL ; // 束流线角阀2开到位 
	PARAM003:BOOL ; // 束流线角阀2关到位 
	PARAM004:BOOL ; // 束流线角阀2正在开 
	PARAM005:BOOL ; // 束流线角阀2正在关 
	PARAM006:BOOL ; // 束流线角阀2开启操作错误 
	PARAM007:BOOL ; // 束流线角阀2关闭操作错误 
	PARAM008:BOOL ; // 束流线放气阀2开到位 
	PARAM009:BOOL ; // 束流线放气阀2关到位 
	PARAM010:BOOL ; // 束流线放气阀2正在开 
	PARAM011:BOOL ; // 束流线放气阀2正在关 
	PARAM012:BOOL ; // 束流线放气阀2开启操作错误 
	PARAM013:BOOL ; // 束流线放气阀2关闭操作错误 
	PARAM014:BOOL ; // 束流线2机械泵开到位 
	PARAM015:BOOL ; // 束流线2机械泵关到位
	PARAM016:BOOL ; // 束流线2机械泵正在开 
	PARAM017:BOOL ; // 束流线2机械泵正在关 
	PARAM018:BOOL ; // 束流线2机械泵开启操作错误 
	PARAM019:BOOL ; // 束流线2机械泵关闭操作错误 
	PARAM020:BOOL ; // 束流线2分子泵V6达到频率值 
	PARAM021:BOOL ; // 束流线2分子泵V6频率下降到0 
	PARAM022:BOOL ; // 束流线2分子泵V6故障 
	PARAM023:BOOL ; // 束流线2分子泵V6频率上升中 
	PARAM024:BOOL ; // 束流线2分子泵V6频率下降中 
	PARAM025:BOOL ; // 束流线2分子泵V6开启操作错误 
	PARAM026:BOOL ; // 束流线2分子泵V6关闭操作错误 
	PARAM027:REAL ; // 束流线2分子泵V6输出频率（Hz） 
	PARAM028:LREAL ; // 束流线2低真空度（mbar） 
	PARAM029:LREAL ; // 束流线2高真空度（mbar） 
	PARAM030:BOOL ; // 束流线2低真空已达标 
	PARAM031:BOOL ; // 束流线2高真空已达标
END_STRUCT
END_TYPE
